{
  "manifest_version": 3,
  "name": "DSH 划线拆图",
  "version": "1.0.0",
  "description": "在任意网页上选中文字，一键调用本地 DSH 服务拆成 AI 知识图（需本机运行 dsh web）。",
  "permissions": [
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "http://127.0.0.1:3080/*",
    "http://localhost:3080/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "DSH 划线拆图"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
