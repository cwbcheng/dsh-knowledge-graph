{
  "manifest_version": 3,
  "name": "DSH 知识图",
  "version": "1.0.1",
  "description": "选中网页文字或粘贴资料，生成可定位原文的知识图。需要本机运行 DSH Web 服务。",
  "permissions": [
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "http://127.0.0.1:3080/*",
    "http://localhost:3080/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "DSH 知识图"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
