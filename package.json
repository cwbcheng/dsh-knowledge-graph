{
  "name": "dsh-knowledge-graph",
  "version": "1.0.0",
  "description": "DSH Cordis plugin: turn arbitrary source text into an AI-generated knowledge graph (facts / inferences / concepts / definitions / examples / counter-examples / rules) with two-way linking between the graph and the original text.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "knowledge-graph",
    "knowledge-base",
    "ai",
    "novel",
    "study-notes"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "scripts": {
    "readme": "node scripts/build-readme.mjs",
    "build:lib": "node scripts/build-lib.mjs && node scripts/build-client.mjs"
  },
  "engines": {
    "node": ">=18"
  }
}
